# Scratch files
commit-msg.txt

# The group's real Circuit history (names + every logged workout). Kept locally as the
# generator source for publicSeed.ts, never committed: only Evan's own slice is public.
src/circuit/seed.ts

# Visual Studio local IDE state — machine-specific, never useful to anyone else
.vs/

# import dry-run output, written next to whatever CSV you point it at
*.parsed.json

# local Claude Code tooling (launch config, task locks) — not part of the site
.claude/

# the Supabase CLI writes its own scratch here — a version string, not source
supabase/.temp/

# vitest --reporter=json scratch output
.vitest/

# Database backups: a decrypted dump is every member's rows, and a key reads every artifact.
# Restore in a directory outside the repository (docs/2026-11-21-database-backup-and-restore.md);
# these are here for the day somebody does not.
*.dump
*.age
*.key
yaya-db-*/
# and the rest of an opened bundle, by name, wherever it was opened
auth-user-ids.txt
auth-user-ids.before.txt
extras.tsv
manifest.tsv
manifest.before.tsv
moved.txt
restore-errors.txt
after-restore.sql
