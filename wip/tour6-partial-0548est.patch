+import { describe, expect, it, vi } from 'vitest'
+
+/*
+ * A shared window's sharer is never told who follows it (shared.ts's header) — and the Lab's
+ * Follow now is, to its leader alone (Evan, 26 Nov 2026; src/lab/social/gate.ts's labWhere). The
+ * exception is the Lab's, and this keeps it there: following a window, or everything somebody
+ * shows, or stopping, puts nothing on the call's channel at all.
+ */
+const sent = vi.hoisted(() => [] as [string, unknown][])
+vi.mock('../voice/voiceSession', () => ({
+  sendParty: (kind: string, body: unknown) => sent.push([kind, body]),
+  onParty: () => () => {},
+  voiceSession: { subscribe: () => () => {}, getState: () => ({ inCall: true }) },
+}))
+/* a state push is queued on a timer; node has no window, and its own timers are the same thing */
+vi.stubGlobal('window', globalThis)
+const { shared } = await import('./shared')
+
+describe('a shared window’s sharer is still never told', () => {
+  it('following, following everything, and stopping each send nothing', () => {
+    shared.register(
+      'visualizer',
+      () => ({ mode: 1 }),
+      () => {},
+    )
+    sent.length = 0
+    shared.follow('visualizer', 'ann')
+    shared.followAll('ann')
+    shared.unfollow('visualizer')
+    shared.followAll('bo')
+    shared.unfollowAll('bo')
+    expect(sent).toEqual([])
+    /* and the room is what changed, here and only here */
+    expect(shared.getState().following).toEqual({})
+    expect(shared.getState().followingAll).toEqual([])
+  })
+  it('while offering a window does go out: the probe hears a send when there is one', () => {
+    sent.length = 0
+    shared.offer('visualizer', 'Visualiser')
+    expect(sent.map(([kind]) => kind)).toContain('win')
+    shared.withdraw('visualizer')
+  })
+})
