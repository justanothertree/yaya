+import { describe, expect, it } from 'vitest'
+import { hereKey } from './whereEveryone'
+import type { PartyHere } from './party'
+
+/*
+ * The snapshot the App and the Lab read (usePartyHere) is rebuilt only when its key changes, and
+ * the party's state is replaced on every pointer sample — so the key is the line between "a
+ * heartbeat saying the same" and "something somebody can see changed".
+ */
+describe('who is where, as one key (hereKey)', () => {
+  /* every field away from its default */
+  const bo: PartyHere = {
+    id: 'bo',
+    name: 'Bo',
+    route: 'lab',
+    skin: 'pen',
+    sub: 'swarm',
+    fol: 'ann',
+    at: 1000,
+  }
+  it('the snapshot changes when somebody starts or stops following, never on a heartbeat saying the same', () => {
+    const { fol: _fol, ...unfollowed } = bo
+    void _fol
+    expect(hereKey(unfollowed)).not.toBe(hereKey(bo))
+    expect(hereKey({ ...bo, fol: 'cy' })).not.toBe(hereKey(bo))
+    /* a heartbeat: the same facts, a later time */
+    expect(hereKey({ ...bo, at: 6000 })).toBe(hereKey(bo))
+  })
+  it('and still on everything else a ring or a strip shows', () => {
+    for (const change of [
+      { route: 'paint' },
+      { sub: 'chess' },
+      { sub: undefined },
+      { skin: undefined },
+      { name: 'Bob' },
+      { id: 'cy' },
+    ] as Partial<PartyHere>[])
+      expect([change, hereKey({ ...bo, ...change }) !== hereKey(bo)]).toEqual([change, true])
+  })
+})
