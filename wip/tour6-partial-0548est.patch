+  leader: Pick<PartyHere, 'route' | 'sub'> | undefined
+}): { sub?: string; fol?: string } {
+  if (a.route !== 'lab' || !a.allowed || !a.toy) return {}
+  const shows = a.leader?.route === 'lab' && !!a.leader.sub
+  return a.following && shows ? { sub: a.toy, fol: a.following } : { sub: a.toy }
