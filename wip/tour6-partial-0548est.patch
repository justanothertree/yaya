--- /dev/null
+++ b/src/lab/social/following.ts
@@ -0,0 +1,29 @@
+/**
+ * Whom you follow on the Lab (TourStrip's Follow), or null — a store in held.ts's shape, so the
+ * party can read it when it says where you are (party.ts's announceHere, through gate.ts's
+ * labWhere) and say it again the moment it changes.
+ *
+ * ⚠️ ONLY YOUR OWN PRESS SETS IT. Follow and Stop, a toy you pick yourself (GpuLab's pick, a link),
+ * the follow ending in words (useFollow), and the Lab unmounting. Nothing anybody else sends can,
+ * and the one you follow gets no control over it: they are told, and that is all (tour.ts).
+ *
+ * Kept in this module rather than in GpuLab's state because the party lives in the site's main
+ * bundle and the Lab does not; nothing here is stored or sent by itself.
+ */
+let following: string | null = null
+const listeners = new Set<() => void>()
+
+export const follows = {
+  get: (): string | null => following,
+  set(id: string | null) {
+    if (following === id) return
+    following = id
+    listeners.forEach((l) => l())
+  },
+  subscribe(fn: () => void) {
+    listeners.add(fn)
+    return () => {
+      listeners.delete(fn)
+    }
+  },
+}
